# Keep scripts used for build/release and their unit tests only
/scripts/*
!/scripts/build-apk.sh
!/scripts/build-ios.sh
!/scripts/android-release.py
!/scripts/android-preflight.py
!/scripts/android-device-package.py
!/scripts/release_preflight.py
